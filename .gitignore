node_modules/
.truefact/
*.log
.env
OUTREACH.md

# business / strategy docs — never ship to the public OSS repo
strategy/
bench/out/*
!bench/out/report.md
!bench/out/report.json
!bench/out/oracle.jsonl
bench/showcase/*
!bench/showcase/showcase.md
demo-run.jsonl

# live real-site campaign — per-trial logs stay local; the report is tracked
# (a public claim must cite a reproducible artifact). Mirrors bench/out.
live/out/*
!live/out/.gitkeep
!live/out/report.md
!live/out/report.json
!live/out/manifest.jsonl

# build output — npm ships it via "files"+prepublishOnly; git installs build it via "prepare"
dist/
