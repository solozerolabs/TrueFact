{
  "name": "truefact",
  "version": "0.1.1",
  "description": "Runtime wrapper for browser-agent write actions: reads the live page and returns an independent landed/did-not-land/inconclusive verdict, without trusting the agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "truefact": "dist/cli.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --import tsx --test-concurrency=1 --test \"test/*.test.ts\"",
    "probe": "node scripts/probe-stagehand.mjs",
    "probe:act": "node --env-file=.env scripts/probe-overlay-act.mjs",
    "probe:omlx": "node scripts/probe-omlx-act.mjs",
    "probe:tree": "node scripts/probe-tree.mjs",
    "probe:targets": "node scripts/probe-multitarget.mjs",
    "bench": "node --env-file-if-exists=.env scripts/bench/run.mjs",
    "bench:score": "node scripts/bench/score.mjs",
    "bench:showcase": "node --env-file-if-exists=.env scripts/bench/showcase.mjs"
  },
  "keywords": [
    "browser-agent",
    "stagehand",
    "verification",
    "postcondition",
    "benchmark"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@browserbasehq/stagehand": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@browserbasehq/stagehand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^4.1.0",
    "@types/node": "^22.20.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solozerolabs/TrueFact.git"
  },
  "homepage": "https://github.com/solozerolabs/TrueFact#readme",
  "bugs": {
    "url": "https://github.com/solozerolabs/TrueFact/issues"
  }
}
