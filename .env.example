# Benchmark ladder keys. Copy to `.env` (git-ignored) and fill in.
# The runner (scripts/bench/run.mjs) adds a rung per key present and skips the
# rest; the local oMLX rung needs no key. Run:  npm run bench
#
# The false-success rate should fall as the rung climbs weak -> strong; that
# curve is the headline the single-model local run cannot produce on its own.
# Model ids below are Stagehand model names — edit to whatever your provider
# currently serves.

ANTHROPIC_API_KEY=      # adds haiku-4-5, sonnet-4-5, opus-4-8 rungs
OPENAI_API_KEY=         # adds the gpt rung
